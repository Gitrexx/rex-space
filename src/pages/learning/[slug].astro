---
import '../../styles/pages/learning-item.css';
import { getCollection } from 'astro:content';
import config from '../../../astro-theme-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const entries = await getCollection('learning');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { item: { slug: entry.id, ...entry.data } },
  }));
}

// Eagerly load every self-contained HTML file in `src/embeds/` as a raw string
// at build time, keyed by resolved path. An item's `embed` filename is matched
// against these and injected into the frame via `srcdoc` (isolated document).
const embedModules = import.meta.glob('../../embeds/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

function resolveEmbed(name?: string): string | undefined {
  if (!name) return undefined;
  const match = Object.entries(embedModules).find(([path]) => path.endsWith(`/${name}`));
  if (!match) {
    throw new Error(
      `learning item embed "${name}" not found in src/embeds/. Available: ${Object.keys(
        embedModules
      )
        .map((p) => p.split('/').pop())
        .join(', ')}`
    );
  }
  return match[1];
}

const { item } = Astro.props;
const embedHtml = resolveEmbed(item.embed);
---

<BaseLayout title={item.title} description={item.description} bodyClass="learning-item-body">
  <!-- The topic IS the page: one slim toolbar, then the embed takes the rest of the
       window. The site header/footer are hidden here (see learning-item.css). -->
  <main id="main-content" class="learning-item-main" data-learning-item>
    <div class="learning-bar">
      <a class="learning-bar-btn learning-bar-back" href={withBase('/learning/')}>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
        >
        <span>{config.learning.eyebrow}</span>
      </a>
      <h1 class="learning-bar-title">{item.title}</h1>
      <button
        type="button"
        class="learning-bar-btn learning-bar-pill"
        data-reload
        aria-label={`Reload ${item.title}`}
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M21 12a9 9 0 1 1-3-6.7L21 8"></path><path d="M21 3v5h-5"></path></svg
        >
        <span class="learning-bar-label">Reload</span>
      </button>
      {
        item.url && (
          <a
            class="learning-bar-btn learning-bar-pill"
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open ${item.title} in a new tab`}
          >
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17L17 7M8 7h9v9" />
            </svg>
            <span class="learning-bar-label">Open</span>
          </a>
        )
      }
    </div>

    <div class="learning-frame">
      {
        embedHtml ? (
          <iframe title={item.title} srcdoc={embedHtml} allow="fullscreen" />
        ) : (
          <iframe
            title={item.title}
            src={item.url}
            referrerpolicy="no-referrer"
            allow="fullscreen"
          />
        )
      }
    </div>
  </main>
</BaseLayout>

<script>
  function mountLearningItem() {
    const root = document.querySelector<HTMLElement>('[data-learning-item]');
    const iframe = root?.querySelector<HTMLIFrameElement>('.learning-frame iframe');
    if (!root || !iframe) return;

    // Reload the frame in place — handles both `srcdoc` (local embed) and `src` (url).
    root.querySelector<HTMLButtonElement>('[data-reload]')?.addEventListener('click', () => {
      if (iframe.hasAttribute('srcdoc')) {
        // Re-setting srcdoc to the same value reliably reloads a local embed.
        const current = iframe.getAttribute('srcdoc') ?? '';
        iframe.removeAttribute('srcdoc');
        iframe.setAttribute('srcdoc', current);
      } else if (iframe.src) {
        // Reassigning src reliably reloads the frame, even to the same URL.
        const currentSrc = iframe.src;
        iframe.src = currentSrc;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountLearningItem, { once: true });
  } else {
    mountLearningItem();
  }
</script>
