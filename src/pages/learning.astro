---
import '../styles/pages/learning.css';
import { getCollection } from 'astro:content';
import config from '../../astro-theme-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';

const { learning } = config;
const { sections } = learning;
// Learning items are a content collection (one file per item), not a config
// array. The filename is the item's `id`, used as the `/learning/<slug>` path.
const items = (await getCollection('learning')).map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));
const hasItems = items.length > 0;

// Each card has a *home* section derived from the frontmatter: an item backed by
// a self-contained file in `src/embeds/` is ad-hoc, one pointing at an external
// site is a series. (`embed` wins — it is what the detail page actually frames.)
// The third section, `pinned`, has no server-side members: pinning happens in the
// browser and cards are moved into it on load, then back home when unpinned.
const sortByTitle = <T extends { title: string }>(list: T[]) =>
  [...list].sort((a, b) => a.title.localeCompare(b.title));

const seriesItems = sortByTitle(items.filter((item) => !item.embed));
const adhocItems = sortByTitle(items.filter((item) => Boolean(item.embed)));

// Distinct tags across all items, alphabetical — drives the filter chip row.
const allTags = Array.from(
  new Set(
    items
      .flatMap((item) => item.tags ?? [])
      .map((tag) => tag.trim())
      .filter(Boolean),
  ),
).sort((a, b) => a.localeCompare(b));

// Delimited, lowercased tag string per card so the filter can match a whole
// tag (`|react|`) without partial collisions (e.g. 'react' vs 'react native').
const tagKey = (tags?: string[]) =>
  tags && tags.length ? `|${tags.map((t) => t.trim().toLowerCase()).join('|')}|` : '';

const groups = [
  { id: 'series', items: seriesItems, copy: sections.series },
  { id: 'adhoc', items: adhocItems, copy: sections.adhoc },
] as const;
---

<BaseLayout title={learning.title} description={learning.intro}>
  <main id="main-content" class="learning-main" data-learning>
    <header class="learning-hero">
      <p class="learning-eyebrow eyebrow-accent">{learning.eyebrow}</p>
      <h1 class="learning-title">{learning.title}</h1>
      <p class="learning-intro">{learning.intro}</p>
    </header>

    {
      hasItems ? (
        <>
          <div class="learning-controls">
            <div class="learning-search">
              <label class="learning-search-field">
                <span class="sr-only">Search learning topics</span>
                <span class="learning-search-icon" aria-hidden="true">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    focusable="false"
                  >
                    <circle cx="11" cy="11" r="7" />
                    <path d="m16 16 4 4" />
                  </svg>
                </span>
                <input
                  type="search"
                  class="learning-search-input"
                  data-learning-search
                  placeholder="Search topics…"
                  autocomplete="off"
                  spellcheck="false"
                  aria-controls="learning-sections"
                />
              </label>
              <p class="learning-search-status" data-learning-status role="status" aria-live="polite" />
            </div>

            {allTags.length > 0 && (
              <div class="learning-filters" role="group" aria-label="Filter by tag" data-learning-filters>
                {allTags.map((tag) => (
                  <button
                    type="button"
                    class="learning-filter"
                    data-tag={tag.toLowerCase()}
                    aria-pressed="false"
                  >
                    {tag}
                  </button>
                ))}
              </div>
            )}
          </div>

          <div class="learning-sections" id="learning-sections">
            <section class="learning-section" data-section="pinned" aria-labelledby="learning-section-pinned">
              <div class="learning-section-head">
                <h2 class="learning-section-title" id="learning-section-pinned">
                  {sections.pinned.title}
                </h2>
              </div>
              <ul class="learning-grid" data-grid="pinned" />
              <p class="learning-section-empty" data-pinned-empty>
                {sections.pinned.empty}
              </p>
            </section>

            {groups.map((group) => (
              <section
                class="learning-section"
                data-section={group.id}
                aria-labelledby={`learning-section-${group.id}`}
              >
                <div class="learning-section-head">
                  <h2 class="learning-section-title" id={`learning-section-${group.id}`}>
                    {group.copy.title}
                  </h2>
                </div>
                <ul class="learning-grid" data-grid={group.id}>
                  {group.items.map((item, index) => (
                    <li
                      class="learning-card-item"
                      data-card
                      data-slug={item.slug}
                      data-home={group.id}
                      data-order={index}
                      data-search={`${item.title} ${item.description} ${(item.tags ?? []).join(' ')}`.toLowerCase()}
                      data-tags={tagKey(item.tags)}
                    >
                      <a class="learning-card" href={withBase(`/learning/${item.slug}/`)}>
                        <span class="learning-card-title">{item.title}</span>
                        {item.tags && item.tags.length > 0 && (
                          <span class="learning-card-tags">
                            {item.tags.map((tag) => (
                              <span class="learning-card-tag">{tag}</span>
                            ))}
                          </span>
                        )}
                        <span class="learning-card-desc">{item.description}</span>
                        <span class="learning-card-cta">
                          <span>Open</span>
                          <span class="learning-card-arrow" aria-hidden="true">
                            →
                          </span>
                        </span>
                      </a>
                      <button
                        type="button"
                        class="learning-pin"
                        data-pin
                        aria-pressed="false"
                        aria-label={`Pin ${item.title}`}
                        title="Pin"
                      >
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.75"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <path d="M12 17v5" />
                          <path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z" />
                        </svg>
                      </button>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>

          {/*
            Restore pins before first paint, so pinned cards are already in the
            Pinned section when the page renders instead of visibly jumping up a
            moment later. Inline and deliberately minimal — it only moves DOM
            nodes; every listener is wired by the module script below.
          */}
          <script is:inline>
            (function () {
              try {
                const raw = localStorage.getItem('learning-pinned');
                if (!raw) return;
                const slugs = JSON.parse(raw);
                if (!Array.isArray(slugs)) return;
                const grid = document.querySelector('[data-grid="pinned"]');
                if (!grid) return;
                const cards = Array.from(document.querySelectorAll('[data-card]'));
                let moved = 0;
                for (const slug of slugs) {
                  const card = cards.find((el) => el.dataset.slug === slug);
                  if (!card) continue;
                  grid.appendChild(card);
                  const button = card.querySelector('[data-pin]');
                  if (button) {
                    button.setAttribute('aria-pressed', 'true');
                    button.setAttribute('title', 'Unpin');
                  }
                  moved += 1;
                }
                if (moved > 0) {
                  const empty = document.querySelector('[data-pinned-empty]');
                  if (empty) empty.hidden = true;
                }
              } catch {
                /* Private mode or a corrupt value — fall back to the plain layout. */
              }
            })();
          </script>

          <p class="learning-empty" data-learning-empty hidden>
            No topics match your filters.
          </p>
        </>
      ) : (
        <p class="learning-empty-static">No learning materials yet — check back soon.</p>
      )
    }
  </main>
</BaseLayout>

<script>
  const STORAGE_KEY = 'learning-pinned';

  function readPinned(): string[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed) ? parsed.filter((slug) => typeof slug === 'string') : [];
    } catch {
      return [];
    }
  }

  function writePinned(slugs: string[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(slugs));
    } catch {
      /* Storage unavailable — pins stay for this page view only. */
    }
  }

  function mountLearningSearch() {
    const root = document.querySelector<HTMLElement>('[data-learning]');
    if (!root) return;

    const input = root.querySelector<HTMLInputElement>('[data-learning-search]');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
    const filters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-learning-filters] button'));
    const status = root.querySelector<HTMLElement>('[data-learning-status]');
    const empty = root.querySelector<HTMLElement>('[data-learning-empty]');
    const sections = Array.from(root.querySelectorAll<HTMLElement>('[data-section]'));
    const pinnedEmpty = root.querySelector<HTMLElement>('[data-pinned-empty]');

    const grids = new Map<string, HTMLElement>(
      Array.from(root.querySelectorAll<HTMLElement>('[data-grid]')).map((grid) => [
        grid.dataset.grid ?? '',
        grid,
      ]),
    );
    const pinnedGrid = grids.get('pinned');

    const activeTags = new Set<string>();

    function apply() {
      const query = (input?.value ?? '').trim().toLowerCase();
      const filtered = query !== '' || activeTags.size > 0;
      let visible = 0;

      for (const card of cards) {
        const textMatch = query === '' || (card.dataset.search ?? '').includes(query);
        const cardTags = card.dataset.tags ?? '';
        const tagMatch =
          activeTags.size === 0 || Array.from(activeTags).some((tag) => cardTags.includes(`|${tag}|`));
        const match = textMatch && tagMatch;
        card.hidden = !match;
        if (match) visible += 1;
      }

      // A section with nothing left to show drops out rather than leaving a
      // stranded heading. Pinned keeps its empty hint, but only when unfiltered —
      // during a search an empty Pinned section is noise, not information.
      for (const section of sections) {
        const shown = Array.from(section.querySelectorAll<HTMLElement>('[data-card]')).some(
          (card) => !card.hidden,
        );
        const isPinned = section.dataset.section === 'pinned';
        section.hidden = isPinned ? !shown && filtered : !shown;
      }

      if (pinnedEmpty) pinnedEmpty.hidden = (pinnedGrid?.childElementCount ?? 0) > 0;
      if (empty) empty.hidden = visible !== 0;
      if (status) {
        status.textContent = filtered ? `${visible} ${visible === 1 ? 'topic' : 'topics'}` : '';
      }
    }

    // Unpinning returns a card to its home grid at its original alphabetical
    // slot, so the section never reshuffles just because something was pinned.
    function restoreHome(card: HTMLElement) {
      const home = grids.get(card.dataset.home ?? '');
      if (!home) return;
      const order = Number(card.dataset.order ?? 0);
      const next = Array.from(home.children).find(
        (sibling) => Number((sibling as HTMLElement).dataset.order ?? 0) > order,
      );
      home.insertBefore(card, next ?? null);
    }

    function togglePin(card: HTMLElement, button: HTMLButtonElement) {
      const slug = card.dataset.slug;
      if (!slug || !pinnedGrid) return;
      const pin = button.getAttribute('aria-pressed') !== 'true';
      const pinned = readPinned().filter((entry) => entry !== slug);

      if (pin) {
        pinned.push(slug);
        pinnedGrid.appendChild(card);
      } else {
        restoreHome(card);
      }

      button.setAttribute('aria-pressed', String(pin));
      button.setAttribute('title', pin ? 'Unpin' : 'Pin');
      writePinned(pinned);
      apply();
    }

    if (input) {
      input.addEventListener('input', apply);
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          input.value = '';
          apply();
        }
      });
    }

    for (const button of filters) {
      button.addEventListener('click', () => {
        const tag = button.dataset.tag ?? '';
        const next = button.getAttribute('aria-pressed') !== 'true';
        button.setAttribute('aria-pressed', String(next));
        if (next) activeTags.add(tag);
        else activeTags.delete(tag);
        apply();
      });
    }

    for (const card of cards) {
      const button = card.querySelector<HTMLButtonElement>('[data-pin]');
      button?.addEventListener('click', () => togglePin(card, button));
    }

    // Drop slugs for items that no longer exist so the store cannot grow stale.
    const known = new Set(cards.map((card) => card.dataset.slug));
    const stored = readPinned();
    const live = stored.filter((slug) => known.has(slug));
    if (live.length !== stored.length) writePinned(live);

    apply();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountLearningSearch, { once: true });
  } else {
    mountLearningSearch();
  }
</script>
